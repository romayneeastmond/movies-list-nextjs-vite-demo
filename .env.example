# Copy this file to .env.local and fill in your values.
# None of these are exposed to the browser — all calls go through /api routes.

# OMDB API key: https://www.omdbapi.com/apikey.aspx
OMDB_KEY=your_omdb_key_here

# TMDB API key: https://www.themoviedb.org/settings/api
TMDB_KEY=your_tmdb_key_here

# Google Sheets ID (the long string in the Sheet URL between /d/ and /edit)
GOOGLE_SHEET_ID=your_sheet_id_here

# From your service account JSON key file (Google Cloud Console → IAM → Service Accounts → Keys → Add Key → JSON)
# Share your Google Sheet with the service account email before using.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON — keep the quotes and \n characters intact
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
